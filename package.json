{
  "name": "valar-svelte",
  "version": "0.0.1",
  "description": "Personal customization base for the complete shadcn-svelte monorepo",
  "author": {
    "name": "Valar"
  },
  "private": true,
  "scripts": {
    "build": "pnpm build:docs",
    "build:cli": "pnpm -r -F \"./packages/*\" -F \"./sv-addons/*\" build",
    "build:docs": "pnpm -F docs build",
    "dev": "concurrently -n packages,apps --kill-others=false -c \"blue,green\" \"pnpm -r --parallel --color -F './packages/**' dev\" \"wait-on packages/cli/dist/index.mjs && pnpm -r --parallel --color -F docs dev\"",
    "dev:cli": "pnpm -F  \"./packages/**\" --parallel --reporter append-only --color dev",
    "preview": "pnpm -F docs preview",
    "test": "pnpm --color --reporter append-only -F \"./packages/*\" -F \"./sv-addons/*\" -F docs test",
    "check": "pnpm -r --if-present check",
    "lint": "oxfmt --check && eslint . --no-config-lookup --config eslint.config.js",
    "format": "oxfmt",
    "pull:styles": "pnpm -F './docs' pull:styles",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm build:cli && pnpm -r sync",
    "ci:build": "pnpm build:cli",
    "parity": "pnpm -F docs parity",
    "ui": "pnpm --filter @valar/svelte-cli start"
  },
  "engines": {
    "pnpm": ">=9",
    "node": ">=24.22.2 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/onevalar/valar-svelte.git"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/node": "^20",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.4.0",
    "minimatch": "^10.2.4",
    "oxfmt": "^0.61.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0",
    "wait-on": "^9.0.4",
    "wrangler": "^4.75.0"
  }
}
