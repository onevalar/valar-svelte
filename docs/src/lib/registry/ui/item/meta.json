				}
			],
			"accessibility": [
				"整行可点击时用 child 渲染为真实链接或按钮",
				"只有图标的操作要加 aria-label"
			],
			"responsive": ["size（default、sm、xs）适应紧凑空间", "窄屏下操作区可换行"],
