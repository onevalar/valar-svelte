{
	"name": "alert",
	"type": "registry:ui",
	"title": "Alert 提示条",
	"description": "页面内的提示信息块，用于需要用户注意的状态说明。",
	"categories": ["反馈"],
	"meta": {
		"valar": {
			"keywords": ["提示", "alert", "警告", "通知", "横幅"],
			"whenToUse": ["持续显示在页面中的状态或警告"],
			"whenNotToUse": [
				{
					"case": "操作后的短暂通知",
					"use": "sonner"
				},
				{
					"case": "需要用户确认",
					"use": "alert-dialog"
				}
			],
			"accessibility": ["重要提示使用 role=alert", "不只靠颜色区分类型，配合图标和文字"],
			"responsive": ["窄屏下图标与文字保持对齐，文字可换行"],
			"related": ["sonner", "card"]
		}
	}
}
