{
	"name": "radio-group",
	"type": "registry:ui",
	"title": "Radio Group 单选组",
	"description": "从少量互斥选项中选一个，所有选项同时可见。",
	"categories": ["表单"],
	"meta": {
		"valar": {
			"keywords": ["单选", "radio", "单选组", "选项"],
			"whenToUse": ["2–5 个互斥选项，需要用户比较后选择"],
			"whenNotToUse": [
				{
					"case": "选项很多",
					"use": "select"
				},
				{
					"case": "可以多选",
					"use": "checkbox"
				},
				{
					"case": "切换视图或模式",
					"use": "tabs"
				}
			],
			"accessibility": ["整组有 legend 或 aria-label", "方向键在选项间移动"],
			"responsive": ["窄屏下纵向排列"],
			"related": ["select", "checkbox", "toggle-group"]
		}
	}
}
