{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "bubble",
	"title": "Bubble 消息气泡",
	"type": "registry:ui",
	"description": "对话中的消息气泡，支持多种变体、对齐、分组和表情反应。",
	"devDependencies": [
		"tailwind-variants@^3.3.0"
	],
	"meta": {
		"valar": {
			"keywords": [
				"消息气泡",
				"bubble",
				"聊天",
				"chat",
				"对话",
				"reaction"
			],
			"whenToUse": [
				"聊天文字、引用回复、建议和反应的气泡外观"
			],
			"whenNotToUse": [
				{
					"case": "完整的消息行（头像、名字、时间、操作）",
					"use": "message"
				},
				{
					"case": "系统提示或日期分隔",
					"use": "marker"
				},
				{
					"case": "agent 的推理和工具调用步骤",
					"use": "trace"
				}
			],
			"accessibility": [
				"表情反应整组设 role=img 和描述性 aria-label，只读一次",
				"可点击的气泡用 child 渲染为真实 button 或 a",
				"变体颜色之外配合文字或对齐表达含义"
			],
			"responsive": [
				"气泡宽度随内容，最多占容器 80%；ghost 变体不限宽"
			],
			"related": [
				"message",
				"marker",
				"message-scroller"
			]
		}
	},
	"files": [
		{
			"content": "# Bubble 设计规范\n\n- 用于聊天中带框的消息内容；一条消息的整行布局（头像、对齐、发送者）交给 Message，左右对齐写在 `Message.Root` 的 `align` 上，而不是 Bubble。\n- 样式只用 `variant`（`default`、`secondary`、`muted`、`tinted`、`outline`、`ghost`、`destructive`）；助手的长文本、富内容用 `ghost` 占满整行。不要只靠颜色表示含义，`destructive` 气泡的错误原因要写在文字里。\n- 同一发送者连续的气泡放进 `Bubble.Group`。\n- 表情回应用 `Bubble.Reactions`（`side`、`align` 定位），只展示时给它设 `role=\"img\"` 和概括全部回应的 `aria-label`；可点击时改用带 `aria-label` 的图标按钮。回应会压在气泡边缘，行间要留出间距。\n- 整个气泡需要可点击时，用 `Bubble.Content` 的 `child` snippet 渲染为 Button 或链接，不要给 div 加 `onclick`。\n",
			"type": "registry:file",
			"target": "bubble/RULES.md"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { Snippet } from \"svelte\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchild,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tchild?: Snippet<[{ props: Record<string, unknown> }]>;\n\t} = $props();\n\n\tconst mergedProps = $derived({\n\t\tclass: cn(\n\t\t\t\"rounded-xl border border-transparent px-3 py-2 text-sm leading-relaxed [button,a]:outline-none [button,a]:focus-visible:border-ring [button,a]:focus-visible:ring-3 [button,a]:focus-visible:ring-ring/50 group-data-[align=end]/bubble:self-end w-fit max-w-full min-w-0 overflow-hidden wrap-break-word [button]:text-left [button,a]:transition-colors\",\n\t\t\tclassName\n\t\t),\n\t\t\"data-slot\": \"bubble-content\",\n\t\t...restProps,\n\t});\n</script>\n\n{#if child}\n\t{@render child({ props: mergedProps })}\n{:else}\n\t<div bind:this={ref} {...mergedProps}>\n\t\t{@render mergedProps.children?.()}\n\t</div>\n{/if}\n",
			"type": "registry:file",
			"target": "bubble/bubble-content.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"bubble-group\"\n\tclass={cn(\"gap-2 flex min-w-0 flex-col\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "bubble/bubble-group.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const bubbleReactionsVariants = tv({\n\t\tbase: \"rounded-full ring-3 ring-card bg-muted shrink-0 gap-1 px-1.5 py-0.5 has-[button]:p-0 text-sm absolute z-10 flex w-fit items-center justify-center\",\n\t\tvariants: {\n\t\t\tside: {\n\t\t\t\ttop: \"top-0 -translate-y-3/4\",\n\t\t\t\tbottom: \"bottom-0 translate-y-3/4\",\n\t\t\t},\n\t\t\talign: {\n\t\t\t\tstart: \"left-3\",\n\t\t\t\tend: \"right-3\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tside: \"bottom\",\n\t\t\talign: \"end\",\n\t\t},\n\t});\n\n\texport type BubbleReactionsSide = VariantProps<typeof bubbleReactionsVariants>[\"side\"];\n\texport type BubbleReactionsAlign = VariantProps<typeof bubbleReactionsVariants>[\"align\"];\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tside = \"bottom\",\n\t\talign = \"end\",\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tside?: BubbleReactionsSide;\n\t\talign?: BubbleReactionsAlign;\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"bubble-reactions\"\n\tdata-align={align}\n\tdata-side={side}\n\tclass={cn(bubbleReactionsVariants({ side, align }), className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "bubble/bubble-reactions.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const bubbleVariants = tv({\n\t\tbase: \"gap-1 data-[align=end]:self-end max-w-[80%] data-[variant=ghost]:max-w-full group-data-[align=end]/message:self-end group/bubble relative flex w-fit min-w-0 flex-col\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"*:data-[slot=bubble-content]:bg-primary *:data-[slot=bubble-content]:text-primary-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-primary/80\",\n\t\t\t\tsecondary: \"*:data-[slot=bubble-content]:bg-secondary *:data-[slot=bubble-content]:text-secondary-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[color-mix(in_oklch,var(--secondary),var(--foreground)_5%)]\",\n\t\t\t\tmuted: \"*:data-[slot=bubble-content]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[color-mix(in_oklch,var(--muted),var(--foreground)_5%)]\",\n\t\t\t\ttinted: \"*:data-[slot=bubble-content]:bg-[oklch(from_var(--primary)_0.93_calc(c*0.4)_h)] dark:*:data-[slot=bubble-content]:bg-[oklch(from_var(--primary)_0.3_calc(c*0.4)_h)] *:data-[slot=bubble-content]:text-foreground [&>[data-slot=bubble-content]:is(button,a):hover]:bg-[oklch(from_var(--primary)_0.88_calc(c*0.5)_h)] dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-[oklch(from_var(--primary)_0.35_calc(c*0.5)_h)]\",\n\t\t\t\toutline: \"*:data-[slot=bubble-content]:bg-background *:data-[slot=bubble-content]:border-border [&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:text-foreground dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-input/30\",\n\t\t\t\tghost: \"*:data-[slot=bubble-content]:rounded-none *:data-[slot=bubble-content]:bg-transparent *:data-[slot=bubble-content]:p-0 [&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted [&>[data-slot=bubble-content]:is(button,a):hover]:text-foreground dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-muted/50 border-none\",\n\t\t\t\tdestructive: \"*:data-[slot=bubble-content]:bg-destructive/10 dark:*:data-[slot=bubble-content]:bg-destructive/20 *:data-[slot=bubble-content]:text-destructive [&>[data-slot=bubble-content]:is(button,a):hover]:bg-destructive/20 dark:[&>[data-slot=bubble-content]:is(button,a):hover]:bg-destructive/30\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t},\n\t});\n\n\texport type BubbleVariant = VariantProps<typeof bubbleVariants>[\"variant\"];\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\talign = \"start\",\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tvariant?: BubbleVariant;\n\t\talign?: \"start\" | \"end\";\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"bubble\"\n\tdata-variant={variant}\n\tdata-align={align}\n\tclass={cn(bubbleVariants({ variant }), className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "bubble/bubble.svelte"
		},
		{
			"content": "import Content from \"./bubble-content.svelte\";\nimport Group from \"./bubble-group.svelte\";\nimport Reactions, {\n\tbubbleReactionsVariants,\n\ttype BubbleReactionsAlign,\n\ttype BubbleReactionsSide,\n} from \"./bubble-reactions.svelte\";\nimport Root, { bubbleVariants, type BubbleVariant } from \"./bubble.svelte\";\n\nexport {\n\tRoot,\n\tGroup,\n\tContent,\n\tReactions,\n\tbubbleVariants,\n\tbubbleReactionsVariants,\n\ttype BubbleVariant,\n\ttype BubbleReactionsSide,\n\ttype BubbleReactionsAlign,\n\t//\n\tRoot as Bubble,\n\tGroup as BubbleGroup,\n\tContent as BubbleContent,\n\tReactions as BubbleReactions,\n};\n",
			"type": "registry:file",
			"target": "bubble/index.ts"
		}
	]
}