{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "message",
	"title": "Message 消息",
	"type": "registry:ui",
	"description": "对话中的一条消息行，负责头像、对齐、头部和底部。",
	"meta": {
		"valar": {
			"keywords": [
				"消息",
				"message",
				"聊天",
				"chat",
				"对话",
				"AI 回复"
			],
			"whenToUse": [
				"对话中的一条消息，带头像、发送者、时间和操作",
				"Message.Group 叠放同一发送者的连续消息"
			],
			"whenNotToUse": [
				{
					"case": "只需要气泡外观",
					"use": "bubble"
				},
				{
					"case": "agent 的推理与工具调用步骤",
					"use": "trace"
				},
				{
					"case": "系统提示与分隔",
					"use": "marker"
				}
			],
			"accessibility": [
				"Message.Footer 中只有图标的操作按钮要加 aria-label",
				"进行中的状态用 marker 并设 role=status"
			],
			"responsive": [
				"align=end 让自己的消息排在另一侧，头像随之移动"
			],
			"related": [
				"bubble",
				"message-scroller",
				"marker"
			]
		}
	},
	"files": [
		{
			"content": "# Message 设计规范\n\n- Message 负责一条消息的整行布局：头像、对齐、发送者和元信息；带框的消息正文用 Bubble，代理执行的步骤用 Trace，状态和分隔用 Marker。\n- 自己发送的消息设 `align=\"end\"`；同一发送者连续的消息放进 `Message.Group`，前几条放空的 `Message.Avatar` 保持对齐。\n- 发送者名称放 `Message.Header`，发送状态、时间等放 `Message.Footer`；Footer 里只有图标的操作按钮都要有 `aria-label`（检查规则 `valar/icon-button-label`）。\n- 进行中的消息用 `<Marker.Root role=\"status\">` 表达状态，读屏器才会播报。\n",
			"type": "registry:file",
			"target": "message/RULES.md"
		},
		{
			"content": "import Avatar from \"./message-avatar.svelte\";\nimport Content from \"./message-content.svelte\";\nimport Footer from \"./message-footer.svelte\";\nimport Group from \"./message-group.svelte\";\nimport Header from \"./message-header.svelte\";\nimport Root from \"./message.svelte\";\n\nexport {\n\tRoot,\n\tGroup,\n\tAvatar,\n\tContent,\n\tHeader,\n\tFooter,\n\t//\n\tRoot as Message,\n\tGroup as MessageGroup,\n\tAvatar as MessageAvatar,\n\tContent as MessageContent,\n\tHeader as MessageHeader,\n\tFooter as MessageFooter,\n};\n",
			"type": "registry:file",
			"target": "message/index.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"message-avatar\"\n\tclass={cn(\n\t\t\"min-w-8 group-has-data-[slot=message-footer]/message:-translate-y-8 flex w-fit shrink-0 items-center justify-center self-end overflow-hidden rounded-full bg-muted\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "message/message-avatar.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"message-content\"\n\tclass={cn(\"gap-2 group-data-[align=end]/message:*:data-slot:self-end flex w-full min-w-0 flex-col wrap-break-word\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "message/message-content.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"message-footer\"\n\tclass={cn(\n\t\t\"text-xs font-medium text-muted-foreground px-2.5 group-has-data-[variant=ghost]/message:px-0 flex max-w-full min-w-0 items-center group-data-[align=end]/message:justify-end\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "message/message-footer.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"message-group\"\n\tclass={cn(\"gap-1.5 flex min-w-0 flex-col\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "message/message-group.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"message-header\"\n\tclass={cn(\"text-xs font-medium text-muted-foreground px-2.5 group-has-data-[variant=ghost]/message:px-0 flex max-w-full min-w-0 items-center\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "message/message-header.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\talign = \"start\",\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\talign?: \"start\" | \"end\";\n\t} = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"message\"\n\tdata-align={align}\n\tclass={cn(\n\t\t\"text-xs gap-1.5 group/message relative flex w-full min-w-0 data-[align=end]:flex-row-reverse\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</div>\n",
			"type": "registry:file",
			"target": "message/message.svelte"
		}
	]
}