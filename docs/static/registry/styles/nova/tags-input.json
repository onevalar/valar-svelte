		{
			"content": "# Tags Input 设计规范\n\n- 用于输入多个自由文本值（标签、邮箱、关键词）；从固定选项中多选用 Checkbox 组或可多选的 Select。\n- 设 `id` 并用 `Field.Label for={id}` 关联可见标签（检查规则 `valar/input-label`）。\n- 默认只用英文逗号分隔：中文界面设 `delimiter={/[,，]/}`，同时支持全角逗号。回车总会添加当前输入。\n- 默认文案是中文（删除按钮名称、必填提示、校验错误和读屏播报）；其他语言传 `removeLabel`、`requiredMessage` 和 `messages`。\n- 校验写在 `validate`：返回字符串作为错误信息显示，不要在外面另写错误文字；需要上限时设 `max`，默认不允许重复（`allowDuplicates`）。\n- 放在表单中提交时设 `name`，每个标签会作为一个同名字段提交；值是字符串数组，用 `bind:value` 绑定。\n",
			"type": "registry:file",
			"target": "tags-input/RULES.md"
		},
		{
			"content": "export {\n\tdefault as TagsInput,\n\ttype TagsInputProps,\n\ttype TagsInputMessages,\n} from \"./tags-input.svelte\";\n",
			"type": "registry:file",
			"target": "tags-input/index.ts"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport type { WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLInputAttributes } from \"svelte/elements\";\n\texport type TagsInputProps = WithElementRef<\n\t\tOmit<HTMLInputAttributes, \"value\" | \"defaultValue\" | \"type\" | \"max\" | \"children\">,\n\t\tHTMLInputElement\n\t> & {\n\t\tvalue?: string[];\n\t\tdefaultValue?: string[];\n\t\tinputValue?: string;\n\t\tdelimiter?: string | RegExp;\n\t\tmax?: number;\n\t\tallowDuplicates?: boolean;\n\t\taddOnPaste?: boolean;\n\t\taddOnTab?: boolean;\n\t\taddOnBlur?: boolean;\n\t\tvalidate?: (tag: string) => boolean | string;\n\t\tonValueChange?: (value: string[]) => void;\n\t\tonAdd?: (tag: string) => void;\n\t\tonRemove?: (tag: string) => void;\n\t\tonInvalid?: (tag: string, reason: string) => void;\n\t\tremoveLabel?: (tag: string) => string;\n\t\trequiredMessage?: string;\n\t\t/** Error and screen reader texts; each one replaces the Chinese default. */\n\t\tmessages?: Partial<TagsInputMessages>;\n\t};\n\texport type TagsInputMessages = {\n\t\tempty: string;\n\t\tduplicate: string;\n\t\tmax: (max: number) => string;\n\t\tinvalid: string;\n\t\tadded: (tag: string) => string;\n\t\tremoved: (tag: string) => string;\n\t\tselected: (tag: string) => string;\n\t};\n\tconst DEFAULT_MESSAGES: TagsInputMessages = {\n\t\tempty: \"标签不能为空。\",\n\t\tduplicate: \"标签已存在。\",\n\t\tmax: (max) => `最多 ${max} 个标签。`,\n\t\tinvalid: \"标签无效。\",\n\t\tadded: (tag) => `已添加 ${tag}`,\n\t\tremoved: (tag) => `已移除 ${tag}`,\n\t\tselected: (tag) => `已选中 ${tag}，按 Delete 删除。`,\n\t};\n</script>\n\n<script lang=\"ts\">\n\timport { onMount, tick, untrack } from \"svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\tlet {\n\t\tref = $bindable(null),\n\t\tdefaultValue = [],\n\t\tvalue = $bindable<string[]>(defaultValue),\n\t\tinputValue = $bindable(\"\"),\n\t\tdelimiter = \",\",\n\t\tmax = 0,\n\t\tallowDuplicates = false,\n\t\taddOnPaste = true,\n\t\taddOnTab = false,\n\t\taddOnBlur = false,\n\t\tvalidate,\n\t\tonValueChange,\n\t\tonAdd,\n\t\tonRemove,\n\t\tonInvalid,\n\t\tremoveLabel = (tag) => `移除 ${tag}`,\n\t\trequiredMessage = \"请至少添加一个标签。\",\n\t\tmessages: messageOverrides,\n\t\tname,\n\t\tform,\n\t\tdisabled = false,\n\t\treadonly = false,\n\t\trequired = false,\n\t\tclass: className,\n\t\tdir,\n\t\toninput,\n\t\tonkeydown,\n\t\tonpaste,\n\t\tonblur,\n\t\toncompositionstart,\n\t\toncompositionend,\n\t\t...restProps\n\t}: TagsInputProps = $props();\n\tconst uid = $props.id();\n\tconst messages = $derived({ ...DEFAULT_MESSAGES, ...messageOverrides });\n\tconst initialValue = untrack(() => [...value]);\n\tconst initialInput = untrack(() => inputValue);\n\tlet root: HTMLDivElement;\n\tlet selected = $state(-1);\n\tlet error = $state(\"\");\n\tlet announcement = $state(\"\");\n\tlet composing = false;\n\tlet composition = 0;\n\tlet lastValue = untrack(() => value);\n\t$effect(() => {\n\t\tconst current = value;\n\t\tuntrack(() => {\n\t\t\tif (current !== lastValue) {\n\t\t\t\tselected = -1;\n\t\t\t\terror = \"\";\n\t\t\t}\n\t\t\tlastValue = current;\n\t\t});\n\t});\n\t$effect(() => {\n\t\tif (ref)\n\t\t\tref.setCustomValidity(\n\t\t\t\t!disabled && !readonly\n\t\t\t\t\t? error || (required && value.length === 0 ? requiredMessage : \"\")\n\t\t\t\t\t: \"\"\n\t\t\t);\n\t});\n\tfunction update(next: string[]) {\n\t\tvalue = next;\n\t\tlastValue = value;\n\t\tonValueChange?.([...next]);\n\t}\n\tfunction add(text: string) {\n\t\tif (disabled || readonly || composing) return false;\n\t\tconst tag = text.trim();\n\t\tconst custom = tag ? validate?.(tag) : undefined;\n\t\tconst reason = !tag\n\t\t\t? messages.empty\n\t\t\t: !allowDuplicates && value.includes(tag)\n\t\t\t\t? messages.duplicate\n\t\t\t\t: max > 0 && value.length >= max\n\t\t\t\t\t? messages.max(max)\n\t\t\t\t\t: custom === false\n\t\t\t\t\t\t? messages.invalid\n\t\t\t\t\t\t: typeof custom === \"string\"\n\t\t\t\t\t\t\t? custom\n\t\t\t\t\t\t\t: \"\";\n\t\tif (reason) {\n\t\t\terror = reason;\n\t\t\tonInvalid?.(tag, reason);\n\t\t\treturn false;\n\t\t}\n\t\tupdate([...value, tag]);\n\t\terror = \"\";\n\t\tselected = -1;\n\t\tonAdd?.(tag);\n\t\tannouncement = messages.added(tag);\n\t\treturn true;\n\t}\n\tasync function remove(index: number) {\n\t\tif (disabled || readonly || composing) return;\n\t\tconst tag = value[index];\n\t\tupdate(value.filter((_, i) => i !== index));\n\t\terror = \"\";\n\t\tselected = Math.min(index, value.length - 1);\n\t\tonRemove?.(tag);\n\t\tannouncement = messages.removed(tag);\n\t\tawait tick();\n\t\tref?.focus();\n\t}\n\tfunction addMany(text: string, complete: boolean) {\n\t\tconst parts = delimiter ? text.split(delimiter) : [text];\n\t\tconst tail = complete ? \"\" : (parts.pop() ?? \"\");\n\t\tconst rejected: string[] = [];\n\t\tlet rejection = \"\";\n\t\tfor (const part of parts) {\n\t\t\tif (part.trim() && !add(part)) {\n\t\t\t\trejected.push(part);\n\t\t\t\trejection = error;\n\t\t\t}\n\t\t}\n\t\tif (rejection) error = rejection;\n\t\tinputValue = [...rejected, tail]\n\t\t\t.filter(Boolean)\n\t\t\t.join(typeof delimiter === \"string\" ? delimiter : \",\");\n\t}\n\tfunction keydown(event: KeyboardEvent & { currentTarget: HTMLInputElement }) {\n\t\tonkeydown?.(event);\n\t\tif (\n\t\t\tevent.defaultPrevented ||\n\t\t\tevent.isComposing ||\n\t\t\tevent.keyCode === 229 ||\n\t\t\tcomposing ||\n\t\t\tdisabled ||\n\t\t\treadonly\n\t\t)\n\t\t\treturn;\n\t\tif ((event.key === \"Enter\" || (event.key === \"Tab\" && addOnTab)) && inputValue.trim()) {\n\t\t\tevent.preventDefault();\n\t\t\tif (add(inputValue)) inputValue = \"\";\n\t\t\treturn;\n\t\t}\n\t\tconst input = event.currentTarget;\n\t\tif (input.selectionStart !== 0 || input.selectionEnd !== 0) {\n\t\t\tselected = -1;\n\t\t\treturn;\n\t\t}\n\t\tconst rtl = getComputedStyle(input).direction === \"rtl\";\n\t\tif (event.key === (rtl ? \"ArrowRight\" : \"ArrowLeft\")) {\n\t\t\tevent.preventDefault();\n\t\t\tselected = selected < 0 ? value.length - 1 : Math.max(0, selected - 1);\n\t\t} else if (event.key === (rtl ? \"ArrowLeft\" : \"ArrowRight\") && selected >= 0) {\n\t\t\tevent.preventDefault();\n\t\t\tselected = selected === value.length - 1 ? -1 : selected + 1;\n\t\t} else if ((event.key === \"Backspace\" || event.key === \"Delete\") && value.length) {\n\t\t\tif (selected >= 0) {\n\t\t\t\tevent.preventDefault();\n\t\t\t\tvoid remove(selected);\n\t\t\t} else if (event.key === \"Backspace\") {\n\t\t\t\tevent.preventDefault();\n\t\t\t\tselected = value.length - 1;\n\t\t\t}\n\t\t} else if (event.key === \"Home\" && selected >= 0) {\n\t\t\tevent.preventDefault();\n\t\t\tselected = 0;\n\t\t} else if (event.key === \"End\" && selected >= 0) {\n\t\t\tevent.preventDefault();\n\t\t\tselected = value.length - 1;\n\t\t} else if (event.key === \"Escape\") {\n\t\t\tselected = -1;\n\t\t\terror = \"\";\n\t\t}\n\t}\n\tonMount(() => {\n\t\tconst owner = ref?.form;\n\t\tlet resetTimer: ReturnType<typeof setTimeout>;\n\t\tfunction reset(event: Event) {\n\t\t\tclearTimeout(resetTimer);\n\t\t\tresetTimer = setTimeout(() => {\n\t\t\t\tif (event.defaultPrevented) return;\n\t\t\t\tupdate([...initialValue]);\n\t\t\t\tinputValue = initialInput;\n\t\t\t\tif (ref) ref.value = initialInput;\n\t\t\t\tselected = -1;\n\t\t\t\terror = \"\";\n\t\t\t}, 0);\n\t\t}\n\t\towner?.addEventListener(\"reset\", reset);\n\t\treturn () => {\n\t\t\tcomposition++;\n\t\t\tclearTimeout(resetTimer);\n\t\t\towner?.removeEventListener(\"reset\", reset);\n\t\t};\n\t});\n</script>\n\n<div\n\tbind:this={root}\n\t{dir}\n\tdata-slot=\"tags-input\"\n\tdata-disabled={disabled || undefined}\n\tclass={cn(\n\t\t\"flex min-h-10 w-full flex-wrap items-center gap-1.5 rounded-md border border-input bg-background p-1.5 text-foreground shadow-xs focus-within:border-ring focus-within:ring-2 focus-within:ring-ring/30 has-aria-invalid:border-destructive\",\n\t\tclassName\n\t)}\n>\n\t<ul id={`${uid}-tags`} aria-label=\"标签\" class=\"contents\">\n\t\t{#each value as tag, index (index)}\n\t\t\t<li\n\t\t\t\tdata-slot=\"tags-input-item\"\n\t\t\t\tdata-selected={selected === index || undefined}\n\t\t\t\tclass=\"inline-flex max-w-full min-w-0 items-center gap-1 rounded-sm bg-secondary px-2 py-1 text-sm text-secondary-foreground data-selected:ring-2 data-selected:ring-ring\"\n\t\t\t>\n\t\t\t\t<span class=\"break-all\">{tag}</span>\n\t\t\t\t<button\n\t\t\t\t\ttype=\"button\"\n\t\t\t\t\taria-label={removeLabel(tag)}\n\t\t\t\t\tdisabled={disabled || readonly}\n\t\t\t\t\tclass=\"size-5 shrink-0 rounded-sm text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-40\"\n\t\t\t\t\tonclick={() => remove(index)}>×</button\n\t\t\t\t>\n\t\t\t</li>\n\t\t{/each}\n\t</ul>\n\t<input\n\t\t{...restProps}\n\t\tbind:this={ref}\n\t\ttype=\"text\"\n\t\tdata-slot=\"tags-input-input\"\n\t\tclass=\"h-7 min-w-20 flex-1 bg-transparent px-1 text-sm outline-none disabled:cursor-not-allowed disabled:opacity-50\"\n\t\t{dir}\n\t\t{form}\n\t\t{disabled}\n\t\t{readonly}\n\t\trequired={required && value.length === 0}\n\t\tvalue={inputValue}\n\t\taria-invalid={!!error || restProps[\"aria-invalid\"] || undefined}\n\t\taria-describedby={[restProps[\"aria-describedby\"], `${uid}-status`, error ? `${uid}-error` : \"\"]\n\t\t\t.filter(Boolean)\n\t\t\t.join(\"\")}\n\t\toninput={(event) => {\n\t\t\tinputValue = event.currentTarget.value;\n\t\t\terror = \"\";\n\t\t\tselected = -1;\n\t\t\tif (\n\t\t\t\t!composing &&\n\t\t\t\t!(event instanceof InputEvent && event.inputType === \"insertFromPaste\" && !addOnPaste) &&\n\t\t\t\tdelimiter &&\n\t\t\t\tinputValue.split(delimiter).length > 1\n\t\t\t)\n\t\t\t\taddMany(inputValue, false);\n\t\t\toninput?.(event);\n\t\t}}\n\t\tonkeydown={keydown}\n\t\tonpaste={(event) => {\n\t\t\tonpaste?.(event);\n\t\t\tif (event.defaultPrevented || !addOnPaste || composing || disabled || readonly) return;\n\t\t\tconst clipboard = event.clipboardData?.getData(\"text\");\n\t\t\tif (clipboard === undefined) return;\n\t\t\tevent.preventDefault();\n\t\t\tconst start = event.currentTarget.selectionStart ?? inputValue.length;\n\t\t\tconst end = event.currentTarget.selectionEnd ?? start;\n\t\t\taddMany(inputValue.slice(0, start) + clipboard + inputValue.slice(end), true);\n\t\t}}\n\t\tonblur={(event) => {\n\t\t\tif (\n\t\t\t\t!root.contains(event.relatedTarget as Node) &&\n\t\t\t\taddOnBlur &&\n\t\t\t\tinputValue.trim() &&\n\t\t\t\tadd(inputValue)\n\t\t\t)\n\t\t\t\tinputValue = \"\";\n\t\t\tselected = -1;\n\t\t\tonblur?.(event);\n\t\t}}\n\t\toncompositionstart={(event) => {\n\t\t\tcomposition++;\n\t\t\tcomposing = true;\n\t\t\toncompositionstart?.(event);\n\t\t}}\n\t\toncompositionend={(event) => {\n\t\t\tinputValue = event.currentTarget.value;\n\t\t\tconst token = composition;\n\t\t\tqueueMicrotask(() => {\n\t\t\t\tif (token === composition) composing = false;\n\t\t\t});\n\t\t\toncompositionend?.(event);\n\t\t}}\n\t/>\n</div>\n<span id={`${uid}-status`} class=\"sr-only\" aria-live=\"polite\"\n\t>{selected >= 0 ? messages.selected(value[selected]) : announcement}</span\n>\n<span id={`${uid}-error`} class=\"mt-1 block text-xs text-destructive\" role=\"status\">{error}</span>\n{#if name}\n\t{#each value as tag, index (index)}<input\n\t\t\ttype=\"hidden\"\n\t\t\t{name}\n\t\t\t{form}\n\t\t\t{disabled}\n\t\t\tvalue={tag}\n\t\t/>{/each}\n{/if}\n",
			"type": "registry:file",
			"target": "tags-input/tags-input.svelte"
		}
