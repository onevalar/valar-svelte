{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "marker",
	"title": "Marker 对话标记",
	"type": "registry:ui",
	"description": "对话中的状态提示、系统说明、带边框的行或带文字的分隔线。",
	"devDependencies": [
		"tailwind-variants@^3.3.0"
	],
	"meta": {
		"valar": {
			"keywords": [
				"对话标记",
				"marker",
				"系统消息",
				"状态",
				"日期分隔",
				"思考中"
			],
			"whenToUse": [
				"对话中的进行中状态（如“思考中…”）、系统说明、日期分隔"
			],
			"whenNotToUse": [
				{
					"case": "用户或助手的消息内容",
					"use": "message"
				},
				{
					"case": "agent 的工具调用等步骤",
					"use": "trace"
				},
				{
					"case": "没有文字的普通分隔线",
					"use": "separator"
				}
			],
			"accessibility": [
				"进行中的状态设 role=status，并配合 spinner",
				"带文字的分隔不要加 role=separator，否则文字不会被朗读",
				"Marker.Icon 对读屏隐藏，含义写在 Marker.Content"
			],
			"responsive": [
				"宽度随对话列表"
			],
			"related": [
				"message",
				"trace",
				"separator"
			]
		}
	},
	"files": [
		{
			"content": "# Marker 设计规范\n\n- 用于对话中的状态、系统提示、带边框的行或带文字的分隔；样式只用 `variant`（`default`、`border`、`separator`）。\n- Marker 默认没有角色，按用途选择：进行中的状态（“正在思考…”）设 `role=\"status\"`；带文字的分隔（日期）不要加 `role=\"separator\"`，否则文字不会被读出。\n- `Marker.Icon` 对读屏器隐藏，含义写在 `Marker.Content` 里；只有图标时给 `Marker.Root` 设 `aria-label`。\n- 可点击时用 `child` snippet 渲染为 Button 或链接。\n",
			"type": "registry:file",
			"target": "marker/RULES.md"
		},
		{
			"content": "import Content from \"./marker-content.svelte\";\nimport Icon from \"./marker-icon.svelte\";\nimport Root, { markerVariants, type MarkerVariant } from \"./marker.svelte\";\n\nexport {\n\tRoot,\n\tIcon,\n\tContent,\n\tmarkerVariants,\n\ttype MarkerVariant,\n\t//\n\tRoot as Marker,\n\tIcon as MarkerIcon,\n\tContent as MarkerContent,\n};\n",
			"type": "registry:file",
			"target": "marker/index.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLSpanElement>> = $props();\n</script>\n\n<span\n\tbind:this={ref}\n\tdata-slot=\"marker-content\"\n\tclass={cn(\"group-data-[variant=separator]/marker:flex-none group-data-[variant=separator]/marker:text-center *:[a]:hover:text-foreground *:[a]:underline *:[a]:underline-offset-3 min-w-0 wrap-break-word\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</span>\n",
			"type": "registry:file",
			"target": "marker/marker-content.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLSpanElement>> = $props();\n</script>\n\n<span\n\tbind:this={ref}\n\tdata-slot=\"marker-icon\"\n\taria-hidden=\"true\"\n\tclass={cn(\"size-4 [&_svg:not([class*='size-'])]:size-4 shrink-0\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</span>\n",
			"type": "registry:file",
			"target": "marker/marker-icon.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport { tv, type VariantProps } from \"tailwind-variants\";\n\n\texport const markerVariants = tv({\n\t\tbase: \"gap-2 text-xs text-muted-foreground [a]:hover:text-foreground [a]:underline-offset-3 [a]:underline [&_svg:not([class*='size-'])]:size-4 min-h-4 text-left uppercase tracking-wide group/marker relative flex w-full items-center\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"\",\n\t\t\t\tseparator: \"before:h-px before:min-w-0 before:flex-1 before:bg-border after:h-px after:min-w-0 after:flex-1 after:bg-border before:mr-1 after:ml-1\",\n\t\t\t\tborder: \"border-b border-border pb-2\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t},\n\t});\n\n\texport type MarkerVariant = VariantProps<typeof markerVariants>[\"variant\"];\n</script>\n\n<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { Snippet } from \"svelte\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\tchild,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\tvariant?: MarkerVariant;\n\t\tchild?: Snippet<[{ props: Record<string, unknown> }]>;\n\t} = $props();\n\n\tconst mergedProps = $derived({\n\t\tclass: cn(markerVariants({ variant }), className),\n\t\t\"data-slot\": \"marker\",\n\t\t\"data-variant\": variant,\n\t\t...restProps,\n\t});\n</script>\n\n{#if child}\n\t{@render child({ props: mergedProps })}\n{:else}\n\t<div bind:this={ref} {...mergedProps}>\n\t\t{@render mergedProps.children?.()}\n\t</div>\n{/if}\n",
			"type": "registry:file",
			"target": "marker/marker.svelte"
		}
	]
}