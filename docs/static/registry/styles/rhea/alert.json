				"警告",
				"通知",
				"横幅"
			],
			"whenToUse": [
				"持续显示在页面中的状态或警告"
			],
			"whenNotToUse": [
				{
					"case": "操作后的短暂通知",
					"use": "sonner"
				},
				{
					"case": "需要用户确认",
					"use": "alert-dialog"
				}
			],
			"accessibility": [
				"重要提示使用 role=alert",
