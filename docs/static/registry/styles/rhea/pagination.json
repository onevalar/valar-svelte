	"files": [
		{
			"content": "# Pagination 设计规范\n\n- 用 `Pagination.Root` 的 `count`（总条数）、`perPage` 和 `bind:page` 驱动页码，`siblingCount` 控制当前页两侧显示几页；不要自己计算页码列表。\n- 页码用 `Pagination.Link`（当前页设 `isActive`，带 `aria-current=\"page\"`），前后翻页用 `Pagination.Previous`、`Pagination.Next`，省略用 `Pagination.Ellipsis`。\n- 默认文案是中文（导航名称“分页”，按钮“上一页”／“下一页”，省略号“更多页”）：其他语言给 Root 传 `aria-label`，给前后按钮传 `label` 和 `aria-label`，给省略号传 `label`。\n- 翻页后把焦点或滚动位置移回列表开头；页码需要出现在网址中时同步到查询参数，刷新后保持当前页。\n- 条目很少时不显示分页；“加载更多”的无限列表不要用 Pagination。\n",
			"type": "registry:file",
			"target": "pagination/RULES.md"
		},
		{
			"content": "import Content from \"./pagination-content.svelte\";\nimport Ellipsis from \"./pagination-ellipsis.svelte\";\nimport Item from \"./pagination-item.svelte\";\nimport Link from \"./pagination-link.svelte\";\nimport NextButton from \"./pagination-next-button.svelte\";\nimport Next from \"./pagination-next.svelte\";\nimport PrevButton from \"./pagination-prev-button.svelte\";\nimport Previous from \"./pagination-previous.svelte\";\nimport Root from \"./pagination.svelte\";\n\nexport {\n\tRoot,\n\tContent,\n\tItem,\n\tLink,\n\tPrevButton, // old\n\tNextButton, // old\n\tEllipsis,\n\tPrevious,\n\tNext,\n\t//\n\tRoot as Pagination,\n\tContent as PaginationContent,\n\tItem as PaginationItem,\n\tLink as PaginationLink,\n\tPrevButton as PaginationPrevButton, // old\n\tNextButton as PaginationNextButton, // old\n\tEllipsis as PaginationEllipsis,\n\tPrevious as PaginationPrevious,\n\tNext as PaginationNext,\n};\n",
			"type": "registry:file",
			"target": "pagination/index.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLUListElement>> = $props();\n</script>\n\n<ul\n\tbind:this={ref}\n\tdata-slot=\"pagination-content\"\n\tclass={cn(\"gap-1 flex items-center\", className)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</ul>\n",
			"type": "registry:file",
			"target": "pagination/pagination-content.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn, type WithElementRef, type WithoutChildren } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tlabel = \"更多页\",\n\t\t...restProps\n\t}: WithoutChildren<WithElementRef<HTMLAttributes<HTMLSpanElement>>> & {\n\t\t/** Screen reader text. */\n\t\tlabel?: string;\n\t} = $props();\n</script>\n\n<span\n\tbind:this={ref}\n\taria-hidden=\"true\"\n\tdata-slot=\"pagination-ellipsis\"\n\tclass={cn(\"size-8 items-center justify-center [&_svg:not([class*='size-'])]:size-4 flex items-center justify-center\", className)}\n\t{...restProps}\n>\n\t<IconPlaceholder\n\t\tlucide=\"MoreHorizontalIcon\"\n\t\ttabler=\"IconDots\"\n\t\thugeicons=\"MoreHorizontalCircle01Icon\"\n\t\tphosphor=\"DotsThreeIcon\"\n\t\tremixicon=\"RiMoreLine\"\n\t/>\n\t<span class=\"sr-only\">{label}</span>\n</span>\n",
			"type": "registry:file",
			"target": "pagination/pagination-ellipsis.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport type { WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLLiAttributes } from \"svelte/elements\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tchildren,\n\t\t...restProps\n\t}: WithElementRef<HTMLLiAttributes> = $props();\n</script>\n\n<li bind:this={ref} data-slot=\"pagination-item\" {...restProps}>\n\t{@render children?.()}\n</li>\n",
			"type": "registry:file",
			"target": "pagination/pagination-item.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport { buttonVariants, type ButtonSize } from \"$UI$/button/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tsize = \"icon\",\n\t\tisActive,\n\t\tpage,\n\t\tchildren,\n\t\t...restProps\n\t}: PaginationPrimitive.PageProps & {\n\t\tsize?: ButtonSize;\n\t\tisActive: boolean;\n\t} = $props();\n</script>\n\n{#snippet Fallback()}\n\t{page.value}\n{/snippet}\n\n<PaginationPrimitive.Page\n\tbind:ref\n\t{page}\n\taria-current={isActive ? \"page\" : undefined}\n\tdata-slot=\"pagination-link\"\n\tdata-active={isActive}\n\tdata-size={size}\n\tclass={cn(\n\t\tbuttonVariants({ size, variant: isActive ? \"outline\" : \"ghost\" }),\n\t\t\"\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{#if children}\n\t\t{@render children?.()}\n\t{:else}\n\t\t{@render Fallback()}\n\t{/if}\n</PaginationPrimitive.Page>\n",
			"type": "registry:file",
			"target": "pagination/pagination-link.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { buttonVariants } from \"../button/index.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\tlabel = \"下一页\",\n\t\t...restProps\n\t}: PaginationPrimitive.NextButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n</script>\n\n{#snippet Fallback()}\n\t<span>{label}</span>\n\t<IconPlaceholder\n\t\tlucide=\"ChevronRightIcon\"\n\t\ttabler=\"IconChevronRight\"\n\t\thugeicons=\"ArrowRightIcon\"\n\t\tphosphor=\"CaretRightIcon\"\n\t\tremixicon=\"RiArrowRightSLine\"\n\t\tclass={cn(\"cn-rtl-flip size-4\", className)}\n\t/>\n{/snippet}\n\n<PaginationPrimitive.NextButton\n\tbind:ref\n\taria-label=\"下一页\"\n\tclass={cn(buttonVariants({ variant: \"ghost\" }), \"pr-1.5!\", className)}\n\t{...restProps}\n>\n\t{#if children}\n\t\t{@render children?.()}\n\t{:else}\n\t\t{@render Fallback()}\n\t{/if}\n</PaginationPrimitive.NextButton>\n",
			"type": "registry:file",
			"target": "pagination/pagination-next-button.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { buttonVariants } from \"$UI$/button/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tlabel = \"下一页\",\n\t\t...restProps\n\t}: PaginationPrimitive.NextButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n</script>\n\n<PaginationPrimitive.NextButton\n\tbind:ref\n\taria-label=\"下一页\"\n\tclass={cn(buttonVariants({ variant: \"ghost\", size: \"default\" }), \"pr-1.5!\", className)}\n\t{...restProps}\n>\n\t<span class=\"hidden sm:block\">{label}</span>\n\t<IconPlaceholder\n\t\tlucide=\"ChevronRightIcon\"\n\t\ttabler=\"IconChevronRight\"\n\t\thugeicons=\"ArrowRight01Icon\"\n\t\tphosphor=\"CaretRightIcon\"\n\t\tremixicon=\"RiArrowRightSLine\"\n\t\tdata-icon=\"inline-end\"\n\t\tclass=\"cn-rtl-flip\"\n\t/>\n</PaginationPrimitive.NextButton>\n",
			"type": "registry:file",
			"target": "pagination/pagination-next.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\timport { buttonVariants } from \"../button/index.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tchildren,\n\t\tlabel = \"上一页\",\n\t\t...restProps\n\t}: PaginationPrimitive.PrevButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n</script>\n\n{#snippet Fallback()}\n\t<IconPlaceholder\n\t\tlucide=\"ChevronLeftIcon\"\n\t\ttabler=\"IconChevronLeft\"\n\t\thugeicons=\"ArrowLeftIcon\"\n\t\tphosphor=\"CaretLeftIcon\"\n\t\tremixicon=\"RiArrowLeftSLine\"\n\t\tclass={cn(\"cn-rtl-flip size-4\", className)}\n\t/>\n\t<span>{label}</span>\n{/snippet}\n\n<PaginationPrimitive.PrevButton\n\tbind:ref\n\taria-label=\"上一页\"\n\tclass={cn(buttonVariants({ variant: \"ghost\" }), \"pl-1.5!\", className)}\n\t{...restProps}\n>\n\t{#if children}\n\t\t{@render children?.()}\n\t{:else}\n\t\t{@render Fallback()}\n\t{/if}\n</PaginationPrimitive.PrevButton>\n",
			"type": "registry:file",
			"target": "pagination/pagination-prev-button.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { buttonVariants } from \"$UI$/button/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tlabel = \"上一页\",\n\t\t...restProps\n\t}: PaginationPrimitive.PrevButtonProps & {\n\t\t/** Visible button text. */\n\t\tlabel?: string;\n\t} = $props();\n</script>\n\n<PaginationPrimitive.PrevButton\n\tbind:ref\n\taria-label=\"上一页\"\n\tclass={cn(\n\t\tbuttonVariants({ variant: \"ghost\", size: \"default\" }),\n\t\t\"pl-1.5!\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t<IconPlaceholder\n\t\tlucide=\"ChevronLeftIcon\"\n\t\ttabler=\"IconChevronLeft\"\n\t\thugeicons=\"ArrowLeft01Icon\"\n\t\tphosphor=\"CaretLeftIcon\"\n\t\tremixicon=\"RiArrowLeftSLine\"\n\t\tdata-icon=\"inline-start\"\n\t\tclass=\"cn-rtl-flip\"\n\t/>\n\t<span class=\"hidden sm:block\">{label}</span>\n</PaginationPrimitive.PrevButton>\n",
			"type": "registry:file",
			"target": "pagination/pagination-previous.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Pagination as PaginationPrimitive } from \"bits-ui\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tcount = 0,\n\t\tperPage = 10,\n\t\tpage = $bindable(1),\n\t\tsiblingCount = 1,\n\t\t...restProps\n\t}: PaginationPrimitive.RootProps = $props();\n</script>\n\n<PaginationPrimitive.Root\n\tbind:ref\n\tbind:page\n\trole=\"navigation\"\n\taria-label=\"分页\"\n\tdata-slot=\"pagination\"\n\t{count}\n\t{perPage}\n\t{siblingCount}\n\tclass={cn(\"mx-auto flex w-full justify-center\", className)}\n\t{...restProps}\n/>\n",
			"type": "registry:file",
			"target": "pagination/pagination.svelte"
		}
	]
