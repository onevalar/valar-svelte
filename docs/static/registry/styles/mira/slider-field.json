{
	"$schema": "http://127.0.0.1:5186/schema/registry-item.json",
	"name": "slider-field",
	"title": "Slider Field 滑块数值",
	"type": "registry:ui",
	"description": "滑块与数值输入框组合，拖动调整或直接输入精确数值。",
	"registryDependencies": [
		"number-field",
		"slider"
	],
	"meta": {
		"valar": {
			"keywords": [
				"滑块",
				"slider",
				"数值",
				"范围",
				"参数调节"
			],
			"whenToUse": [
				"在已知范围内调整数值，并需要精确输入"
			],
			"whenNotToUse": [
				{
					"case": "没有明确范围的数字",
					"use": "number-field"
				},
				{
					"case": "只需粗略拖动",
					"use": "slider"
				}
			],
			"accessibility": [
				"标签同时命名滑块和输入框",
				"超出范围的输入标为无效而不是静默截断"
			],
			"responsive": [
				"窄屏下滑块与输入框保持同一行，空间不足时换行"
			],
			"related": [
				"slider",
				"number-field",
				"field"
			]
		}
	},
	"files": [
		{
			"content": "# Slider Field 设计规范\n\n- 用于有明确范围、又需要精确数值的参数（尺寸、透明度、音量）；只需粗略拖动时用 Slider，没有范围的数字用 Number Field。\n- `label` 必填，它同时命名滑块、数字输入框和加减按钮，并显示为可见标签；不要在外面再包一个 Field.Label。\n- 单位写在 `unit`（如 `unit=\"px\"`），它只显示在数字后面，不进入值；值始终是数字。\n- 必须给出 `min`、`max`、`step`。超出范围或无法解析的输入会被标为无效并保持上一个有效值，不要另外写截断逻辑。\n- 放在表单中提交时设 `name`，提交的是纯数字。\n",
			"type": "registry:file",
			"target": "slider-field/RULES.md"
		},
		{
			"content": "export { default as SliderField, type SliderFieldProps } from \"./slider-field.svelte\";\n",
			"type": "registry:file",
			"target": "slider-field/index.ts"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\texport type SliderFieldProps = Omit<HTMLAttributes<HTMLDivElement>, \"children\"> & {\n\t\t/** Visible label; also names the slider and the number input. */\n\t\tlabel: string;\n\t\tvalue?: number;\n\t\tmin?: number;\n\t\tmax?: number;\n\t\tstep?: number;\n\t\t/** Shown after the number, e.g. \"px\". Not part of the value. */\n\t\tunit?: string;\n\t\tdisabled?: boolean;\n\t\t/** Submitted by the number input as a plain number. */\n\t\tname?: string;\n\t\tonValueChange?: (value: number) => void;\n\t};\n</script>\n\n<script lang=\"ts\">\n\timport { NumberField } from \"$UI$/number-field/index.js\";\n\timport { Slider } from \"$UI$/slider/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tlabel,\n\t\tvalue = $bindable(0),\n\t\tmin = 0,\n\t\tmax = 100,\n\t\tstep = 1,\n\t\tunit,\n\t\tdisabled = false,\n\t\tname,\n\t\tonValueChange,\n\t\tid: idProp,\n\t\tclass: className,\n\t\t...restProps\n\t}: SliderFieldProps = $props();\n\tconst generated = $props.id();\n\tconst id = $derived(idProp ?? generated);\n\n\tfunction set(next: number | undefined) {\n\t\t// An emptied or invalid number box keeps the last value instead of becoming 0.\n\t\t// Out-of-range typing is shown as invalid by the number box until it is corrected.\n\t\tif (next === undefined || !Number.isFinite(next) || next < min || next > max) return;\n\t\tif (Object.is(next, value)) return;\n\t\tvalue = next;\n\t\tonValueChange?.(next);\n\t}\n</script>\n\n<div\n\tdata-slot=\"slider-field\"\n\tdata-disabled={disabled || undefined}\n\tclass={cn(\"grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2\", className)}\n\t{...restProps}\n>\n\t<label for={`${id}-input`} class=\"col-span-2 text-sm font-medium\">{label}</label>\n\t<Slider\n\t\ttype=\"single\"\n\t\t{value}\n\t\tonValueChange={set}\n\t\t{min}\n\t\t{max}\n\t\t{step}\n\t\t{disabled}\n\t\taria-label={label}\n\t/>\n\t<div class=\"flex items-center gap-1.5\">\n\t\t<NumberField\n\t\t\tid={`${id}-input`}\n\t\t\t{name}\n\t\t\t{value}\n\t\t\tonValueChange={set}\n\t\t\t{min}\n\t\t\t{max}\n\t\t\t{step}\n\t\t\t{disabled}\n\t\t\tclass=\"w-32\"\n\t\t\tdecrementLabel={`减小${label}`}\n\t\t\tincrementLabel={`增大${label}`}\n\t\t/>\n\t\t{#if unit}<span class=\"text-xs text-muted-foreground\">{unit}</span>{/if}\n\t</div>\n</div>\n",
			"type": "registry:file",
			"target": "slider-field/slider-field.svelte"
		}
	]
}